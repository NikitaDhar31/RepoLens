# Copy to .env (git-ignored) or set these in your shell / .streamlit/secrets.toml.

# Required for AI explanations. Static analysis works without it.
ANTHROPIC_API_KEY=

# Optional. Default: claude-opus-5-5
# REPOLENS_MODEL=claude-opus-5-5

# Optional, for private repositories. Prefer a fine-grained personal access token
# restricted to specific repositories with read-only "Contents" and "Metadata".
# You can also paste a token into the app per import instead of setting it here.
# GITHUB_TOKEN=
